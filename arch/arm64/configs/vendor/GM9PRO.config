# GM9PRO PLATFORM
CONFIG_MACH_GM_GM9PRO_SPROUT=y

# INIT
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# PLATFORM
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# AUDIO
CONFIG_SND_SOC_TFA98XX=y
CONFIG_SND_SOC_DBMDX=y
CONFIG_SND_SOC_DBMDX_SND_CAPTURE=y

# EXFAT
CONFIG_EXFAT_FS=y

# EAS
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
# CONFIG_MEMCG_KMEM is not set
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_SCHED_WALT=y
CONFIG_DEFAULT_USE_ENERGY_AWARE=y
CONFIG_SCHED_HRTICK=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
# CONFIG_CPU_BOOST is not set
# CONFIG_SCHED_HMP is not set
# CONFIG_SCHED_HMP_CSTATE_AWARE is not set
# CONFIG_SCHED_CORE_CTL is not set
# CONFIG_SCHED_AUTOGROUP is not set

# F2FS
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_CHECK_FS=y
CONFIG_F2FS_FS_ENCRYPTION=y

# WLAN
CONFIG_QCA_CLD_WLAN=y

# LZ4
CONFIG_CRYPTO_LZ4=y

# FINGERPRINT
CONFIG_FINGERPRINT_FPC1020=y

# TOUCHSCREEN
CONFIG_TOUCHSCREEN_SEC_TS=y
CONFIG_SEC_TS_WAKE_GESTURES=y

# MISC
CONFIG_DISABLE_TRACE_PRINTK=y
CONFIG_BLK_CGROUP=y
CONFIG_IOSCHED_BFQ=y
CONFIG_OVERLAY_FS=y

# BPF
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_CONNMARK=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_FTRACE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# CPUFREQ
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=n
CONFIG_CPU_FREQ_GOV_INTERACTIVE=n
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=n

# CONFIG_QCOM_MINIDUMP is not set
# CONFIG_MSM_11AD is not set
# CONFIG_MMC_TEST is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_DVB_MPQ is not set
# CONFIG_DVB_MPQ_DEMUX is not set
# CONFIG_IMX134 is not set
# CONFIG_IMX132 is not set
# CONFIG_OV9724 is not set
# CONFIG_OV5648 is not set
# CONFIG_GC0339 is not set
# CONFIG_OV8825 is not set
# CONFIG_OV8865 is not set
# CONFIG_s5k4e1 is not set
# CONFIG_OV12830 is not set
# CONFIG_MSM_RDBG is not set
# CONFIG_WIL6210 is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_SCSI_UFSHCD_PLATFORM is not set
# CONFIG_SCSI_UFS_QCOM is not set
# CONFIG_SCSI_UFS_QCOM_ICE is not set
# CONFIG_NFC_NQ is not set
# CONFIG_BRIDGE_NETFILTER is not set
# CONFIG_QCOM_PRESERVE_MEM is not set

CONFIG_DEVFREQ_BOOST=y
CONFIG_DEVFREQ_INPUT_BOOST_DURATION_MS=100
CONFIG_DEVFREQ_WAKE_BOOST_DURATION_MS=200
CONFIG_DEVFREQ_MSM_CPUBW_BOOST_FREQ=2086

CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# CONFIG_HZ_100 is not set
CONFIG_HZ_300=y
CONFIG_HZ=300

# UART Console
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
